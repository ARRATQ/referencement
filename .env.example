# === BASE DE DONNÉES ===
DB_NAME=referencement
DB_USER=refuser
DB_PASSWORD=changeme_db_password
DATABASE_URL=postgresql://refuser:changeme_db_password@localhost:5432/referencement

# === SÉCURITÉ JWT (générer avec : openssl rand -hex 32) ===
JWT_SECRET=changeme_jwt_secret_32chars_minimum_here
JWT_REFRESH_SECRET=changeme_refresh_secret_32chars_min

# === JIRA DATA CENTER ===
JIRA_URL=https://your-jira-instance/jira

# === APPLICATION ===
APP_PORT=8090
BACKEND_PORT=3002
APP_ORIGIN=http://localhost:8090
VITE_API_URL=http://localhost:3002
NODE_ENV=production

# === COMPTES INITIAUX ===
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme_admin_password
GESTIONNAIRE_EMAIL=gestionnaire@example.com
GESTIONNAIRE_PASSWORD=changeme_gest_password
PARTICIPANT_EMAIL=participant@example.com
PARTICIPANT_PASSWORD=changeme_part_password
